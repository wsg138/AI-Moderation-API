# Copy to a private runtime .env or inject through Pterodactyl/runtime secrets.
# Never commit real client tokens or OPENAI_API_KEY.
AI_MOD_DATABASE_PATH=runtime-data/moderation.sqlite3
AI_MOD_POLICY_VERSION=draft
AI_MOD_CLIENTS_JSON=[]

AI_MOD_REQUEST_QUEUE_SIZE=256
AI_MOD_REQUEST_WORKERS=4
AI_MOD_REQUEST_TIMEOUT_MS=250
AI_MOD_CLASSIFIER_TIMEOUT_MS=150

AI_MOD_CONTEXT_WINDOW_SECONDS=45
AI_MOD_CONTEXT_MAX_SCOPES=512
AI_MOD_CONTEXT_MESSAGES_PER_SCOPE=100
AI_MOD_CONTEXT_SENDER_MESSAGES=5
AI_MOD_CONTEXT_CHANNEL_MESSAGES=8

AI_MOD_OPENAI_ADVISORY_ENABLED=false
OPENAI_API_KEY=
AI_MOD_OPENAI_MODEL=omni-moderation-latest
AI_MOD_OPENAI_TIMEOUT_MS=1500
AI_MOD_OPENAI_QUEUE_SIZE=256
AI_MOD_OPENAI_WORKERS=2
