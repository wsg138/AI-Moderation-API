# Variable reference for Pterodactyl/runtime environment injection.
# The service does not auto-load dotenv files; set these in the process environment.
# Never commit real client tokens or OPENAI_API_KEY.
AI_MOD_DATABASE_PATH=runtime-data/moderation.sqlite3
AI_MOD_POLICY_VERSION=v1
AI_MOD_CLIENTS_JSON=[]

# Deployment wrapper settings. Localhost is the safe/default production bind.
AI_MOD_BIND_HOST=127.0.0.1
AI_MOD_PORT=8787
AI_MOD_ALLOW_NONLOCAL_BIND=false

AI_MOD_REQUEST_QUEUE_SIZE=256
AI_MOD_REQUEST_WORKERS=4
AI_MOD_REQUEST_TIMEOUT_MS=250
AI_MOD_CLASSIFIER_TIMEOUT_MS=150

# Optional W12 local ONNX classifier. Leave metadata path/checksum unset to stay in stub/fail-open mode.
AI_MOD_ONNX_METADATA_PATH=
AI_MOD_ONNX_METADATA_SHA256=
AI_MOD_ONNX_TIMEOUT_MS=100
AI_MOD_PENDING_STALE_AFTER_MS=30000

AI_MOD_CONTEXT_WINDOW_SECONDS=45
AI_MOD_CONTEXT_MAX_SCOPES=512
AI_MOD_CONTEXT_MESSAGES_PER_SCOPE=100
AI_MOD_CONTEXT_SENDER_MESSAGES=5
AI_MOD_CONTEXT_CHANNEL_MESSAGES=8
AI_MOD_CONTEXT_LINKED_SCOPES=16
AI_MOD_CONTEXT_INTERVENING_MESSAGES=20
AI_MOD_CONTEXT_REHYDRATE_LIMIT=500
AI_MOD_MEMORY_FACT_LIMIT=64

AI_MOD_OPENAI_ADVISORY_ENABLED=false
OPENAI_API_KEY=
AI_MOD_OPENAI_MODEL=omni-moderation-latest
AI_MOD_OPENAI_TIMEOUT_MS=1500
AI_MOD_OPENAI_QUEUE_SIZE=256
AI_MOD_OPENAI_WORKERS=2
